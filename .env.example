# Every variable here is OPTIONAL. The app runs with no .env file at all;
# the values shown are the defaults that apply when a key is absent.
#
# Unknown variables are ignored, so you can drop an existing .env into this
# project without breaking it. Invalid values log a warning and fall back to
# the default rather than failing the boot.

# --- Simulated processing pipeline (server) ---------------------------------
# SIM_LATENCY_MIN_MS=400
# SIM_LATENCY_MAX_MS=2600
# SIM_FAILURE_RATE=0.08
# SIM_REVIEW_RATE=0.15
# SIM_SEED_CORPUS_SIZE=2400
# SIM_SCALE_CORPUS_SIZE=100000
# SIM_TICK_MS=400

# --- Client behaviour -------------------------------------------------------
# NEXT_PUBLIC_PAGE_SIZE=100
# NEXT_PUBLIC_MAX_PARALLEL_UPLOADS=6
# NEXT_PUBLIC_MAX_UPLOAD_ATTEMPTS=3
